  <POU Name="FB_SequentialSingleSuite" Id="{c9861766-2402-41df-8a74-0fbae6a71719}" SpecialFunc="None">
    <Declaration><![CDATA[// One passing test; used by PRG_TEST_SEQUENCE for the N=1 sequential check.
