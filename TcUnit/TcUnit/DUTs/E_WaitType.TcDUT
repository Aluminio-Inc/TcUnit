<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_WaitType" Id="{4db9ff95-8ff6-4357-9c34-09b67956b168}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_WaitType :
(
    None      := 0,
    // 'Duration', not 'Time': TIME is an IEC reserved word; the compiler accepts a
    // qualified_only member named Time, but the 4026 library packer NREs on any
    // E_WaitType.Time reference during Save-as-Library (found 2026-07-17)
    Duration  := 1,
    Condition := 2
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
